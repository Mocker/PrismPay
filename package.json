{
  "name": "prismpay",
  "version": "1.0.0",
  "description": "A budget-aware allowance gate for AI purchasing agents — PayPal AI Hackathon entry",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --experimental-strip-types src/dev-server.ts",
    "dev:wrangler": "wrangler dev --port 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute prismpay-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute prismpay-db --remote --file=./migrations/0001_init.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^3.109.0"
  }
}
